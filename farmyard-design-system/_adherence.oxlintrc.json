{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/sounds/**",
              "components/actions/**",
              "components/badges/**",
              "components/data/**",
              "components/identity/**",
              "components/inputs/**",
              "components/navigation/**",
              "components/overlays/**",
              "components/surfaces/**",
              "ui_kits/barn/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Yellowtail|Special Elite))/i]",
        "message": "Font not provided by the design system. Available: Inter, Yellowtail, Special Elite."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:character|size|src|face|name|assetBase|breathe|ring|ringGeom|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: character, size, src, face, name, assetBase, breathe, ring, ringGeom."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|icon|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|ghost|secondary)$/]",
        "message": "<Button> variant must be one of 'primary' | 'ghost' | 'secondary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|kicker|title|meta|footer|tilt|pinned|style|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, kicker, title, meta, footer, tilt, pinned, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:neon|pink|tube|tube-teal|paper)$/]",
        "message": "<Card> variant must be one of 'neon' | 'pink' | 'tube' | 'tube-teal' | 'paper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tilt'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<Card> tilt must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|children|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: tone, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:pink|teal|outline)$/]",
        "message": "<Chip> tone must be one of 'pink' | 'teal' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hint'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<Hint> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LeagueColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|key|ref|className|style|children)$/]",
        "message": "<LeagueColumn> doesn't accept that prop. Declared props: key, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Medal'] > JSXAttribute > JSXIdentifier[name!=/^(?:place|size|flash|key|ref|className|style|children)$/]",
        "message": "<Medal> doesn't accept that prop. Declared props: place, size, flash."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|children|actions|onClose|inline|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: open, title, children, actions, onClose, inline."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|count|current|onClick|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: icon, label, count, current, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='NeonButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|shape|off|children|key|ref|className|style|children)$/]",
        "message": "<NeonButton> doesn't accept that prop. Declared props: tone, shape, off, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='NeonButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:pink|green|red)$/]",
        "message": "<NeonButton> tone must be one of 'pink' | 'green' | 'red'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NeonButton'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:pill|rect|block)$/]",
        "message": "<NeonButton> shape must be one of 'pill' | 'rect' | 'block'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|chip|actions|key|ref|className|style|children)$/]",
        "message": "<PageHeader> doesn't accept that prop. Declared props: title, chip, actions."
      },
      {
        "selector": "JSXOpeningElement[name.name='Popover'] > JSXAttribute > JSXIdentifier[name!=/^(?:arrow|arrowAt|style|children|key|ref|className|style|children)$/]",
        "message": "<Popover> doesn't accept that prop. Declared props: arrow, arrowAt, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Popover'] > JSXAttribute[name.name='arrow'] > Literal[value!=/^(?:top|bottom|none)$/]",
        "message": "<Popover> arrow must be one of 'top' | 'bottom' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stepper'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|max|onChange|label|sfx|key|ref|className|style|children)$/]",
        "message": "<Stepper> doesn't accept that prop. Declared props: value, min, max, onChange, label, sfx."
      },
      {
        "selector": "JSXOpeningElement[name.name='VoiceButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|on|sub|onClick|key|ref|className|style|children)$/]",
        "message": "<VoiceButton> doesn't accept that prop. Declared props: kind, on, sub, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='VoiceButton'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:live|muted)$/]",
        "message": "<VoiceButton> kind must be one of 'live' | 'muted'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
